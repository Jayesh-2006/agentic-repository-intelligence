# Copy to .env and fill in. .env is git-ignored; never commit real keys.
GEMINI_API_KEY=
# Cost-efficient Gemini model with tool-calling support.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TEMPERATURE=0
# Legacy GROQ_* variables are accepted as fallbacks during migration.
# Max tool-using LLM turns before the agent is forced to give a final answer.
MAX_AGENT_STEPS=8
# Maximum planned steps and model-visible observation size.
MAX_PLAN_STEPS=8
MAX_OBSERVATION_CHARS=6000
# Maximum repair attempts in the guarded modification/verification loop.
MAX_REPAIR_ATTEMPTS=2
# Optional repository command run when verification is explicitly requested.
VERIFICATION_COMMAND=
COMMAND_TIMEOUT_SECONDS=60
# Snapshot repository before protected writes/commands and roll back failed unrepaired changes.
ENABLE_CHECKPOINTS=true
ROLLBACK_ON_REPAIR_LIMIT=true

# Estimated-token budget for one model request (tool schemas included). Older tool
# observations are compacted to fit; keep it safely below your provider limit.
# MODEL_CONTEXT_TOKEN_BUDGET=6500
